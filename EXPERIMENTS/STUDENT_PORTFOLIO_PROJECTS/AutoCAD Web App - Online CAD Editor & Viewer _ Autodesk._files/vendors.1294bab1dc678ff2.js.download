`,controlRules=`query ControlRules(
  $controlType: String
  $insightId: String
  $showExpired: Boolean
  $scope: String
) {
  controlRules(
    controlType: $controlType
    insightId: $insightId
    showExpired: $showExpired
    scope: $scope
  ) {
    items {
      id
      insightId
      contextId
      productLineCode
      controlType
      expirationTs
      __typename
    }
    __typename
  }
}
