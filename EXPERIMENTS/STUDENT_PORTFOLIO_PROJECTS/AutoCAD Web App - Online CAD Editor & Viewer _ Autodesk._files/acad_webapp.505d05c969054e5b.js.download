mingV2_EU'\n        getAccessToken: function(onTokenReady) {\n            var token = urlToken;\n            var timeInSeconds = 3600; // Use value provided by APS Authentication (OAuth) API\n            onTokenReady(token, timeInSeconds);\n        }\n    };\n\n    function isIframe() {\n      return window.parent !== window;\n    }\n\n    // For AUS region: Disable DS_ENDPOINTS so the viewer's LegacyDocument.setRegionalEndpointAndApi()\n    // can auto-detect the Australia CDN from the URN pattern\n    // See firefly.js/src/legacy/LegacyDocument.js\n    if (!urlDisableDsEndpoints) {\n      Autodesk.Viewing.FeatureFlags.set('DS_ENDPOINTS', true);\n    }\n\n    Autodesk.Viewing.Initializer(options, function() {\n\n        var htmlDiv = document.getElementById('forgeViewer');\n        viewer = new Autodesk.Viewing.Viewer3D(htmlDiv);\n        var startedCode = viewer.start();\n        if (startedCode > 0) {\n            console.error('Failed to create a Viewer: WebGL not supported.');\n            shutdownLmv();\n            setMessageToParentWindow('lmv-error', {\n              msg: \"Failed to viewer.start()\"\n            });\n            return;\n        }\n\n        // console.log('Initialization complete, loading a model next...');\n\n        var documentId = 'urn:' + urlDocId;\n        Autodesk.Viewing.Document.load(documentId, onDocumentLoadSuccess, onDocumentLoadFailure);\n\n        function onDocumentLoadFailure() {\n            console.error('Failed fetching Forge manifest');\n            shutdownLmv();\n            setMessageToParentWindow('lmv-error', {\n              msg: \"Cannot load document\"\n            });\n        }\n        \n        function onDocumentLoadSuccess(viewerDocument) {\n          viewer.addEventListener(\n//             We don't need LMV to load the PDF geometry (ie: av.GEOMETRY_LOADED_EVENT, \n// doesn't work on desktop), just the basic information out of the PDF file \n// (ie: dimensions).\n              Autodesk.Viewing.MODEL_ROOT_LOADED_EVENT,\n              onViewerReady,\n              { once: true }\n          );\n\n          var defaultModel\n          const values = viewerDocument.getRoot().search({ type: \"geometry\", role: \"2d\", viewableID: urlLayoutName });\n          if (values && values.length > 0) {\n            defaultModel = values[0];\n          }\n\n          if (defaultModel) {\n            viewer.loadDocumentNode(viewerDocument, defaultModel).catch(err1 => {\n              console.error('Failed to loadDocumentNode()', err1);\n              shutdownLmv();\n              setMessageToParentWindow('lmv-error', {\n                msg: \"Failed to loadDocumentNode()\"\n              });\n            });\n          } else {\n            const errMsg = \"Failed finding layout: (\" + urlLayoutName + \")\";\n            console.error(errMsg);\n            shutdownLmv();\n            setMessageToParentWindow('lmv-error', {\n              msg: errMsg\n            });\n          }\n        }\n\n        function onViewerReady() {\n          const data = viewer.model.getData();\n          const vpId = data.viewports ? data.viewports.length - 1 : 1;\n          const mat4 = viewer.model.getPageToModelTransform(vpId);\n          const dims = data.metadata.page_dimensions;\n\n          // communicate result back to parent\n          setMessageToParentWindow('lmv-ready', {\n            matrix: mat4,\n            page_dimensions: dims\n          });\n\n          // destroy on next frame (only iframe)\n          if (isIframe()) {\n            setTimeout(() => {\n              shutdownLmv();\n            });\n          }\n        }\n\n        function setMessageToParentWindow(type, data) {\n          const msg = {\n            type,\n            ...data\n          };\n          if (window.parent !== window) {\n            window.parent.postMessage(msg, '*');\n          } else {\n            console.log(\"Not in iframe; message:\", msg);\n          }\n        }\n    });\n\n    function shutdownLmv() {\n      if (viewer) {\n        viewer.finish();\n        viewer = null;\n        Autodesk.Viewing.shutdown();\n      }\n    }\n  <\/script>\n\n</body>",eVC=Tm.default.iframe`
